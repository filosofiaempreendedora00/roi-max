# ---------- ROI Max ----------
# Nenhuma chave é obrigatória para o modo REPLAY/BACKTEST.

# The Odds API (free tier = 500 créditos/mês) -> https://the-odds-api.com
# Fornece Betfair Exchange back (h2h) e lay (h2h_lay) via bookmaker keys betfair_ex_*
ODDS_API_KEY=
ODDS_API_MONTHLY_CREDITS=500

# API-Football (free tier = 100 req/dia) -> https://www.api-football.com
APIFOOTBALL_KEY=

# Comissão da Betfair sobre lucro líquido por mercado (0.065 = 6.5%)
BETFAIR_COMMISSION=0.065

# Domínio para deep-link (bet.br para contas brasileiras)
BETFAIR_DOMAIN=www.betfair.bet.br

# Web Push (gere com: python -m roimax.push --generate-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Token simples para proteger a API (desktop e mobile usam o mesmo)
ROIMAX_TOKEN=troque-este-token

# Segredo do agendador externo (GitHub Actions). Separado do token do app:
# um endpoint que gasta crédito não deve ser disparável por quem tem só o
# token que fica no navegador do celular.
CRON_SECRET=

# Vazio = SQLite local. Na nuvem, o Postgres.
# No Supabase use a string do "Transaction pooler" (porta 6543) — a conexão
# direta responde só em IPv6 e a Vercel não fala IPv6.
DATABASE_URL=
